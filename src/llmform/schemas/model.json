{
  "$defs": {
    "Price": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "default": "USD",
          "title": "Currency",
          "type": "string"
        },
        "input_per_mtok": {
          "title": "Input Per Mtok",
          "type": "number"
        },
        "output_per_mtok": {
          "title": "Output Per Mtok",
          "type": "number"
        }
      },
      "required": [
        "input_per_mtok",
        "output_per_mtok"
      ],
      "title": "Price",
      "type": "object"
    }
  },
  "$id": "https://llmform.dev/schemas/v0.1/model.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "max_tokens": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Tokens"
    },
    "price": {
      "anyOf": [
        {
          "$ref": "#/$defs/Price"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "temperature": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Temperature"
    }
  },
  "required": [
    "provider",
    "id"
  ],
  "title": "Model",
  "type": "object",
  "x-llmform-schema-version": "0.1"
}
